10 REM ***************************************************************
20 REM *  P O K E R   --   FIVE CARD DRAW                            *
30 REM *  STEVE NORTH                                                *
40 REM *  CREATIVE COMPUTING  MORRISTOWN, NEW JERSEY                 *
50 REM *  FROM "BASIC COMPUTER GAMES" (AHL, 1978)                    *
60 REM *  RECONSTRUCTED FROM MEMORY AND PERIOD SOURCES, 1978 STYLE   *
70 REM ***************************************************************
80 REM
90 DIM A(52),B(15),C(15)
100 DIM H$(15)
110 RANDOMIZE
120 PRINT TAB(28);"POKER"
130 PRINT TAB(20);"CREATIVE COMPUTING"
140 PRINT TAB(18);"MORRISTOWN, NEW JERSEY"
150 PRINT:PRINT:PRINT
160 PRINT "WELCOME TO THE CASINO.  WE EACH HAVE $200."
170 PRINT "I WILL OPEN THE BETTING BEFORE THE DRAW; YOU OPEN AFTER."
180 PRINT "TO FOLD BET 0; TO CHECK BET .5."
190 PRINT "ENOUGH TALK -- LET'S GET DOWN TO BUSINESS."
200 PRINT
210 M=200: REM   COMPUTER STAKE
220 N=200: REM   PLAYER STAKE
230 P=0:   REM   POT
240 D=0:   REM   DEALER (0=COMPUTER, 1=PLAYER)
250 REM ---- MAIN HAND LOOP ----
260 IF M<=0 THEN 2400
270 IF N<=0 THEN 2500
280 PRINT
290 PRINT "THE ANTE IS $5. I WILL DEAL."
300 IF N<5 THEN N=0:GOTO 270
310 IF M<5 THEN M=0:GOTO 260
320 M=M-5: N=N-5: P=P+10
330 REM ---- SHUFFLE DECK ----
340 FOR I=1 TO 52: A(I)=I: NEXT I
350 FOR I=1 TO 52
360   R=INT(RND(1)*52)+1
370   T=A(I): A(I)=A(R): A(R)=T
380 NEXT I
390 K=0: REM POSITION IN DECK
400 REM ---- DEAL TWO HANDS ----
410 FOR I=1 TO 5: K=K+1: B(I)=A(K): NEXT I:  REM COMPUTER
420 FOR I=1 TO 5: K=K+1: C(I)=A(K): NEXT I:  REM PLAYER
430 REM ---- SORT PLAYER'S HAND ----
440 GOSUB 3000
450 PRINT
460 PRINT "YOUR HAND:"
470 GOSUB 3200
480 REM ---- COMPUTER EVALUATES OWN HAND ----
490 GOSUB 3500
500 V1=V: REM COMPUTER HAND RANK (PRE-DRAW)
510 REM ---- COMPUTER OPENS BETTING ----
520 GOSUB 4000
530 PRINT "I'LL OPEN WITH $";I1
540 X=I1: REM COMPUTER'S BET
550 P=P+X: M=M-X
560 REM ---- PLAYER RESPONDS ----
570 PRINT
580 PRINT "WHAT DO YOU DO";:INPUT Y
590 IF Y=0 THEN 2200
600 IF Y<X THEN PRINT "NOT ENOUGH.": GOTO 580
610 IF Y>N THEN PRINT "YOU CAN'T BET MORE THAN YOU HAVE.": GOTO 580
620 N=N-Y: P=P+Y
630 IF Y=X THEN 700
640 REM PLAYER RAISED; COMPUTER DECIDES
650 R=Y-X
660 IF V1<3 AND RND(1)<.6 THEN 2300
670 IF V1<5 AND RND(1)<.3 THEN 2300
680 M=M-R: P=P+R
690 PRINT "I'LL SEE YOUR $";R;"AND CALL."
700 REM ---- DRAW PHASE ----
710 PRINT
720 PRINT "HOW MANY CARDS DO YOU WANT";:INPUT Z
730 IF Z<0 OR Z>3 THEN PRINT "I CHEAT OCCASIONALLY, BUT YOU CAN'T.": GOTO 720
740 IF Z=0 THEN 830
750 FOR I=1 TO Z
760   PRINT "WHICH CARD";:INPUT J
770   IF J<1 OR J>5 THEN PRINT "I HAVE FIVE CARDS, NOT ";J;".": I=I-1: GOTO 760
780   K=K+1
790   C(J)=A(K)
800 NEXT I
810 GOSUB 3000
820 PRINT "YOUR NEW HAND:": GOSUB 3200
830 REM ---- COMPUTER DRAWS ----
840 GOSUB 4500
850 PRINT "I AM TAKING ";Z9;" CARDS."
860 REM ---- COMPUTER REEVALUATES ----
870 GOSUB 3500
880 V2=V
890 REM ---- PLAYER OPENS SECOND ROUND ----
900 PRINT
910 PRINT "WHAT IS YOUR BET";:INPUT Y
920 IF Y<0 THEN 2200
930 IF Y>N THEN PRINT "YOU CAN'T BET WHAT YOU DON'T HAVE.": GOTO 910
940 REM CHECK
950 IF Y=.5 THEN Y=0: GOTO 1100
960 N=N-Y: P=P+Y
970 REM COMPUTER RESPONDS
980 GOSUB 4800
990 IF F1=1 THEN 2300
1000 IF F1=2 THEN
1010 PRINT "I'LL CALL YOUR $";Y;"."
1020 M=M-Y: P=P+Y
1030 GOTO 1200
1040 REM RAISE
1050 R2=INT(RND(1)*20)+5
1060 IF R2>M THEN R2=M
1070 IF R2>N THEN R2=N
1080 PRINT "I'LL CALL YOUR $";Y;" AND RAISE YOU $";R2;"."
1090 M=M-Y-R2: P=P+Y+R2
1100 PRINT "DO YOU CALL";:INPUT Y2
1110 IF Y2=0 THEN 2200
1120 IF Y2<R2 THEN PRINT "YOU MUST CALL OR FOLD.": GOTO 1100
1130 N=N-R2: P=P+R2
1140 GOTO 1200
1150 REM
1200 REM ---- SHOWDOWN ----
1210 PRINT
1220 PRINT "MY HAND:"
1230 FOR I=1 TO 5: T=C(I): C(I)=B(I): B(I)=T: NEXT I
1240 GOSUB 3000
1250 GOSUB 3200
1260 FOR I=1 TO 5: T=C(I): C(I)=B(I): B(I)=T: NEXT I
1270 GOSUB 3000
1280 REM EVALUATE BOTH
1290 FOR I=1 TO 5: T=C(I): C(I)=B(I): B(I)=T: NEXT I
1300 GOSUB 3000
1310 GOSUB 3500: VC=V: KC=K1
1320 FOR I=1 TO 5: T=C(I): C(I)=B(I): B(I)=T: NEXT I
1330 GOSUB 3000
1340 GOSUB 3500: VP=V: KP=K1
1350 PRINT
1360 IF VC>VP THEN 2000
1370 IF VP>VC THEN 2100
1380 IF KC>KP THEN 2000
1390 IF KP>KC THEN 2100
1400 PRINT "TIE. WE SPLIT THE POT."
1410 M=M+INT(P/2): N=N+P-INT(P/2): P=0
1420 GOTO 260
2000 PRINT "I WIN. THE POT OF $";P;" IS MINE."
2010 M=M+P: P=0
2020 GOTO 260
2100 PRINT "YOU WIN. THE POT OF $";P;" IS YOURS."
2110 N=N+P: P=0
2120 GOTO 260
2200 PRINT "YOU FOLDED. I COLLECT THE $";P;" POT."
2210 M=M+P: P=0
2220 GOTO 260
2300 PRINT "I FOLD. THE $";P;" POT IS YOURS."
2310 N=N+P: P=0
2320 GOTO 260
2400 PRINT "I'M BROKE. YOU WIN THE GAME WITH $";N;"."
2410 STOP
2500 PRINT "YOU'RE BROKE. THE HOUSE WINS WITH $";M;"."
2510 STOP
3000 REM ---- SUBROUTINE: SORT PLAYER HAND C() BY RANK ----
3010 FOR I=1 TO 4
3020   FOR J=I+1 TO 5
3030     IF FN R(C(I)) <= FN R(C(J)) THEN 3060
3040     T=C(I): C(I)=C(J): C(J)=T
3060   NEXT J
3070 NEXT I
3080 RETURN
3200 REM ---- SUBROUTINE: PRINT HAND C() ----
3210 FOR I=1 TO 5
3220   GOSUB 3300
3230   PRINT TAB(2);S$;" OF ";U$
3240 NEXT I
3250 RETURN
3300 REM ---- CARD NAME OF C(I) IN S$ (RANK) AND U$ (SUIT) ----
3310 R1=INT((C(I)-1)/4)+1
3320 S1=C(I)-4*(R1-1)
3325 REM R1: 1=2, 2=3, ... 9=10, 10=J, 11=Q, 12=K, 13=A
3330 IF R1<=8 THEN S$=STR$(R1+1): GOTO 3380
3340 IF R1=9 THEN S$="10": GOTO 3380
3350 IF R1=10 THEN S$="JACK": GOTO 3380
3360 IF R1=11 THEN S$="QUEEN": GOTO 3380
3370 IF R1=12 THEN S$="KING"
3375 IF R1=13 THEN S$="ACE"
3380 IF S1=1 THEN U$="CLUBS"
3381 IF S1=2 THEN U$="DIAMONDS"
3382 IF S1=3 THEN U$="HEARTS"
3383 IF S1=4 THEN U$="SPADES"
3390 RETURN
3500 REM ---- EVALUATE HAND C() -> V (RANK), K1 (HIGH CARD) ----
3510 REM RANKS:
3520 REM   1=HIGH 2=PAIR 3=2PAIR 4=TRIPS 5=STRAIGHT
3530 REM   6=FLUSH 7=FULL 8=QUADS 9=STRAIGHT FLUSH
3540 FOR I=1 TO 5: D(I)=INT((C(I)-1)/4)+1: E(I)=C(I)-4*(D(I)-1): NEXT I
3550 FL=1: FOR I=2 TO 5: IF E(I)<>E(1) THEN FL=0
3555 NEXT I
3560 ST=1: FOR I=2 TO 5: IF D(I)<>D(I-1)+1 THEN ST=0
3565 NEXT I
3570 P1=0:P2=0:T3=0:Q1=0
3580 FOR I=1 TO 5
3590   CT=0
3600   FOR J=1 TO 5: IF D(J)=D(I) THEN CT=CT+1
3605   NEXT J
3610   IF CT=4 THEN Q1=D(I)
3620   IF CT=3 THEN T3=D(I)
3630   IF CT=2 AND D(I)<>P1 AND P1=0 THEN P1=D(I): GOTO 3650
3640   IF CT=2 AND D(I)<>P1 AND P2=0 THEN P2=D(I)
3650 NEXT I
3660 K1=D(5)
3670 IF ST=1 AND FL=1 THEN V=9: RETURN
3680 IF Q1>0 THEN V=8: K1=Q1: RETURN
3690 IF T3>0 AND P1>0 THEN V=7: K1=T3: RETURN
3700 IF FL=1 THEN V=6: RETURN
3710 IF ST=1 THEN V=5: RETURN
3720 IF T3>0 THEN V=4: K1=T3: RETURN
3730 IF P1>0 AND P2>0 THEN V=3: K1=P1: IF P2>P1 THEN K1=P2
3735 IF P1>0 AND P2>0 THEN RETURN
3740 IF P1>0 THEN V=2: K1=P1: RETURN
3750 V=1: RETURN
4000 REM ---- COMPUTER OPENING BET ----
4010 REM BASED ON V1 (HAND STRENGTH) AND BLUFF FACTOR
4020 IF V1>=5 THEN I1=INT(RND(1)*15)+10: GOTO 4070
4030 IF V1>=3 THEN I1=INT(RND(1)*10)+5: GOTO 4070
4040 IF V1=2 THEN I1=INT(RND(1)*8)+3: GOTO 4070
4050 IF RND(1)<.25 THEN I1=INT(RND(1)*10)+5: GOTO 4070 : REM BLUFF
4060 I1=INT(RND(1)*4)+1
4070 IF I1>M THEN I1=M
4080 RETURN
4500 REM ---- COMPUTER DRAW STRATEGY ----
4510 REM V1 IS PRE-DRAW RANK; PICK NUMBER OF CARDS TO DROP
4520 IF V1>=5 THEN Z9=0: RETURN: REM STRAIGHT OR BETTER, KEEP
4530 IF V1=4 THEN Z9=2: REM TRIPS: DRAW 2
4540 IF V1=3 THEN Z9=1: REM 2 PAIR: DRAW 1
4545 IF V1=2 THEN Z9=3: REM PAIR: DRAW 3
4550 IF V1=1 THEN Z9=3: REM HIGH: DRAW 3 (KEEP TOP 2)
4555 REM SUBSTITUTE NEW CARDS INTO B()
4560 FOR I=1 TO Z9
4570   K=K+1: B(I)=A(K)
4580 NEXT I
4590 RETURN
4800 REM ---- COMPUTER RESPONDS TO PLAYER BET ----
4810 REM SETS F1: 1=FOLD 2=CALL 3=RAISE
4820 IF V2>=5 THEN F1=3: RETURN
4830 IF V2>=3 AND Y<=15 THEN F1=2: RETURN
4840 IF V2>=3 THEN
4850 IF RND(1)<.5 THEN F1=2: RETURN
4860 F1=1: RETURN
4870 IF V2=2 AND Y<=10 THEN F1=2: RETURN
4880 IF RND(1)<.2 THEN F1=2: REM SMALL BLUFF
4890 IF F1=0 THEN F1=1
4900 RETURN
9000 DEF FN R(X) = INT((X-1)/4)+1
9999 END
